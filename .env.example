ENVIRONMENT=development
HOST=0.0.0.0
PORT=5023
PUBLIC_URL=http://localhost:5023
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastbooking
DB_SCHEMA=fastbooking
DEPLOY_MODE=monolith
API_BASE_URL=http://localhost:5023
SESSION_SECRET=replace-with-a-long-random-value

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5023/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

POSTMARK_API_TOKEN=
FROM_EMAIL=info@fastsme.com

# Optional hosted online checkout; leave blank to use pay-at-facility.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# FastClinic connector rows reference an environment-variable name, never a secret.
FASTCLINIC_API_TOKEN=
